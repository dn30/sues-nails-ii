# Copy to .dev.vars for local development.

# Soft-launch Basic Auth for /booking (and admin fallback when Google is not configured)
ADMIN_USERNAME=anhthynguyen78@gmail.com
ADMIN_PASSWORD=change-me

# Google OAuth for /admin (invite-only). Create an OAuth client in Google Cloud Console.
# Authorized redirect URI: http://localhost:8787/admin/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=replace-with-a-long-random-string

# Optional: send invite emails via Resend (https://resend.com)
RESEND_API_KEY=
INVITE_FROM_EMAIL=Sue's Nails <onboarding@resend.dev>

# Optional override if the public URL differs from the request origin
# AUTH_BASE_URL=http://localhost:8787
